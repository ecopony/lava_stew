ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_MAPS_API_KEY=...
API_SERVER_PORT=3001
RABBITMQ_URL=amqp://lava:stew@localhost:5672

# Database configuration (for local development outside Docker)
# Use port 5433 to connect to the PostgreSQL container from your host machine
# The container internally uses port 5432, but it's mapped to 5433 on the host
DB_HOST=localhost
DB_PORT=5433
DB_NAME=lava_stew
DB_USER=postgres
DB_PASSWORD=postgres
